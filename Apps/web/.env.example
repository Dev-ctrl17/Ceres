# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GTM_CONTAINER_ID=GTM-XXXXXXXX

# EstateOS Private API (server-side only — NEVER expose in frontend JS)
# Service-role key is used by the /api/estateos/properties serverless function
# to read private/unpublished listings and look up hashed API keys.
# Set the REAL values in Vercel environment variables, NOT in this file.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: static (development/test) API key hashes, comma-separated.
# In production, keys live in the `estateos_api_keys` table instead.
# Generate a key with: node -e "console.log(require('crypto').createHash('sha256').update('estateos_live_<32-hex>').digest('hex'))"
ESTATEOS_STATIC_KEY_HASHES=

# Formspree Configuration
# Primary email recipient
VITE_FORMSPREE_FORM_ID=xwvgegde
# Secondary email via Formsubmit
# Option 1: Just email (e.g. luxurypropertiesltd00@gmail.com)
# Option 2: Full path (e.g. el/lemanu) -> https://formsubmit.co/el/lemanu
# Sign up at: https://formsubmit.co/
VITE_FORMSUBMIT_EMAIL=el/lemanu

# Prospect Referral Module (server-side Vercel function)
# Configure the dedicated EmailJS service and template named prospect_referral_notification.
PROSPECT_REFERRAL_EMAILJS_SERVICE_ID=your_prospect_referral_emailjs_service_id
PROSPECT_REFERRAL_EMAILJS_TEMPLATE_ID=prospect_referral_notification
PROSPECT_REFERRAL_EMAILJS_PUBLIC_KEY=your_prospect_referral_emailjs_public_key
PROSPECT_REFERRAL_RECIPIENT=info@luxurypropertiesltd.com.ng
# Optional CRM intake endpoint
PROSPECT_REFERRAL_CRM_WEBHOOK_URL=
# Comma-separated email allowlist for the admin prospect-referral Edge Function
REFERRAL_ADMIN_EMAILS=admin@example.com

# WhatsApp Business API (Optional - for WhatsApp notifications)
# Sign up at: https://wati.io/, https://twilio.com/, or https://interakt.ai/
VITE_WHATSAPP_API_URL=https://your-whatsapp-api-url.com
VITE_WHATSAPP_API_KEY=your-whatsapp-api-key
VITE_WHATSAPP_PHONE_NUMBER=2349056201176
