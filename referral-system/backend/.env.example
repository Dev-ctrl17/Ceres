# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://luxurypropertiesltd.com.ng

# Admin key for POST /api/commissions/process
COMMISSION_ADMIN_KEY=change-me-to-a-long-random-secret

# Server port
PORT=3001